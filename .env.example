# ========== LLM 配置 ==========
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ========== 数据库配置 ==========
# 方式一：单数据源（向后兼容）
DATABASE_URL=sqlite:///./data/demo.db

# 方式二：多数据源（JSON 数组格式）
# 配置此项后会覆盖上方的 DATABASE_URL
# DATASOURCES=[{"id":"local","name":"本地SQLite","url":"sqlite:///./data/demo.db","type":"sqlite"},{"id":"mysql_prod","name":"MySQL生产库","url":"mysql+pymysql://user:password@host:3306/dbname","type":"mysql"},{"id":"pg_analytics","name":"PG分析库","url":"postgresql+psycopg2://user:password@host:5432/dbname","type":"postgresql"}]

# ========== MySQL 连接串格式 ==========
# mysql+pymysql://用户名:密码@主机:端口/数据库名
# 例: mysql+pymysql://root:123456@localhost:3306/mydb

# ========== PostgreSQL 连接串格式 ==========
# postgresql+psycopg2://用户名:密码@主机:端口/数据库名
# 例: postgresql+psycopg2://postgres:123456@localhost:5432/mydb

# ========== 安全配置 ==========
MAX_ROWS=100
QUERY_TIMEOUT=10
MAX_QUESTION_LENGTH=500
LLM_MAX_RETRIES=1
